---
import copy from '../data/copy.json';
import '../styles/site.css';
const { lang = 'en', title, description, alternate = '/' } = Astro.props;
const t = copy[lang as keyof typeof copy];
const base = lang === 'zh' ? '/zh/' : '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3929b8" />
    <title>{title || t.pageTitle}</title>
    <meta name="description" content={description || t.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'zh-CN' : 'en'} href={canonical} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={new URL(alternate, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Codex Resets" href={`${base}feed.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title || t.pageTitle} />
    <meta property="og:description" content={description || t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Codex Resets" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header wrap">
      <a class="brand" href={base} aria-label="Codex Resets"><span class="brand-icon" aria-hidden="true">↻</span><span>codex<span class="brand-light">resets</span><small>.net</small></span></a>
      <nav aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
        <a href={`${base}#archive`}>{t.archive}</a><a href={`${base}#guide`}>{t.guide}</a>
      </nav>
      <a class="language" href={alternate} lang={lang === 'zh' ? 'en' : 'zh-CN'}>{lang === 'zh' ? 'English' : '中文'} <span aria-hidden="true">⌄</span></a>
    </header>
    <main id="main"><slot /></main>
    <footer class="wrap site-footer"><div class="footer-top"><a class="brand" href={base}><span class="brand-icon small" aria-hidden="true">↻</span>codexresets.net</a><a href={`${base}feed.xml`}>{t.rss} ↗</a></div><p>{t.footer}</p><p>{t.privacy}</p></footer>
  </body>
</html>
