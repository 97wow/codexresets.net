---
import Base from '../layouts/Base.astro';
import copy from '../data/copy.json';
import snapshot from '../data/snapshot.json';
import { renderTracker } from '../lib/tracker.js';
const { lang = 'en' } = Astro.props;
const l = lang as keyof typeof copy;
const t = copy[l];
---
<Base lang={l} alternate={l === 'zh' ? '/' : '/zh/'}>
  <div class="dashboard wrap" data-language={l}>
    <div id="tracker" set:html={renderTracker(snapshot,l)}></div>
    <details class="explanation" id="guide"><summary>{t.guideTitle}</summary><p>{t.methodText}</p><div class="definitions"><div><h3>{t.automatic}</h3><p>{t.autoText}</p></div><div><h3>{t.banked}</h3><p>{t.bankText}</p></div></div><p>{t.feedNote}</p><a href="https://learn.chatgpt.com/docs/pricing" target="_blank" rel="noopener noreferrer">{t.official} ↗</a></details>
  </div>
</Base>
<script>
  import { renderTracker, dateLabel } from '../lib/tracker.js';
  import copy from '../data/copy.json';
  const root = document.querySelector<HTMLElement>('#tracker')!;
  const lang = document.querySelector<HTMLElement>('[data-language]')!.dataset.language as keyof typeof copy;
  const t = copy[lang];
  let expanded = false, postsExpanded = false, filter = 'all', busy = false, communityBusy = false, notificationBusy = false, lastPayload = '';
  let floatingTooltip:HTMLElement|null=null,tooltipTarget:HTMLElement|null=null;
  const notificationKey = 'codex-resets-browser-alerts';
  const visitKey = 'codex-resets-visit-v1';
  const timeModeKey = 'codex-resets-time-mode';
  type TimeMode='tibo'|'local';
  let timeMode:TimeMode=localStorage.getItem(timeModeKey)==='tibo'?'tibo':'local';
  function applyTimeMode(){
    const locale=document.documentElement.lang||'en',timeZone=timeMode==='tibo'?'America/Los_Angeles':undefined;
    const formatter=new Intl.DateTimeFormat(locale,{year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',timeZoneName:'short',timeZone});
    root.querySelectorAll<HTMLElement>('[data-timestamp]').forEach(item=>{const date=new Date(item.dataset.timestamp||'');if(Number.isFinite(date.getTime()))item.textContent=formatter.format(date);});
    root.querySelectorAll<HTMLButtonElement>('[data-time-mode]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.timeMode===timeMode)));
  }
  function setTimeMode(mode:string){if(mode!=='tibo'&&mode!=='local')return;timeMode=mode;localStorage.setItem(timeModeKey,mode);applyTimeMode();hideTooltip();}
  const flagEmoji=(country:string)=>/^[A-Z]{2}$/.test(country)&&country!=='XX'?[...country].map(char=>String.fromCodePoint(127397+char.charCodeAt(0))).join(''):'🌍';
  function paintCommunity(stats:{visitors?:number,beg?:{count?:number,countries?:Record<string,number>},country?:string},message='') {
    const total=root.querySelector<HTMLElement>('.beg-total'),visitors=root.querySelector<HTMLElement>('.visitor-total'),flags=root.querySelector<HTMLElement>('.country-flags'),feedback=root.querySelector<HTMLElement>('.beg-feedback');
    if(total)total.textContent=String(stats.beg?.count||0);if(visitors)visitors.textContent=String(stats.visitors||0);
    if(feedback&&message)feedback.textContent=message;
    if(flags){flags.replaceChildren();Object.entries(stats.beg?.countries||{}).sort((a,b)=>b[1]-a[1]).slice(0,10).forEach(([country,count])=>{const item=document.createElement('span');item.textContent=`${flagEmoji(country)} ${count}`;item.title=country;flags.append(item);});}
  }
  async function loadCommunity(record=true) {
    try{
      const shouldRecord=record&&!localStorage.getItem(visitKey);
      const response=await fetch(shouldRecord?'/api/community/visit':'/api/community/stats',{method:shouldRecord?'POST':'GET',credentials:'same-origin',signal:AbortSignal.timeout(8000)});
      if(!response.ok)throw new Error('Unavailable');const stats=await response.json();paintCommunity(stats);
      if(shouldRecord)localStorage.setItem(visitKey,'1');
    }catch{/* Community counters never block reset information. */}
  }
  async function begForReset(){
    if(communityBusy)return;communityBusy=true;const button=root.querySelector<HTMLButtonElement>('.beg-button');if(button)button.disabled=true;
    try{const response=await fetch('/api/community/beg',{method:'POST',credentials:'same-origin',signal:AbortSignal.timeout(8000)});if(!response.ok)throw new Error('Unavailable');const stats=await response.json();paintCommunity(stats,`${flagEmoji(stats.country)} ${stats.added?t.begDone:t.begAlready}`);if(button){button.dataset.done='true';button.textContent=stats.added?t.begDone:t.begAlready;}}
    catch{const feedback=root.querySelector<HTMLElement>('.beg-feedback');if(feedback)feedback.textContent=t.offline;}
    finally{communityBusy=false;if(button)button.disabled=false;}
  }
  function updateNotificationButton() {
    const button = root.querySelector<HTMLButtonElement>('.notify-toggle');
    const note = root.querySelector<HTMLElement>('.browser-channel p');
    if (!button || !note) return;
    if (!('Notification' in window)) { button.disabled=true; button.textContent=t.notifyUnsupported; note.textContent=t.notifyUnsupportedNote; return; }
    if(Notification.permission==='denied'){button.disabled=true;button.textContent=t.notifyBlocked;note.textContent=t.notifyDenied;return;}
    const enabled=localStorage.getItem(notificationKey)==='on'&&Notification.permission==='granted';
    button.dataset.enabled=String(enabled);button.textContent=enabled?t.notifyOn:t.browserAction;
    note.textContent=Notification.permission==='denied'?t.notifyDenied:(enabled?t.notifyOnNote:t.channelBrowserDesc);
  }
  function notificationDialog(){return root.querySelector<HTMLDialogElement>('.notify-dialog');}
  function openNotification(channel='browser'){
    const dialog=notificationDialog();if(!dialog)return;dialog.dataset.channel=channel;
    root.querySelectorAll<HTMLElement>('[data-notify-pane]').forEach(pane=>pane.hidden=pane.dataset.notifyPane!==channel);
    if(!dialog.open)typeof dialog.showModal==='function'?dialog.showModal():dialog.setAttribute('open','');void loadNotifyConfig();
  }
  function notificationResult(message:string,secret=''){
    const result=root.querySelector<HTMLElement>('.notify-result');if(!result)return;
    result.replaceChildren();result.textContent=message;
    if(secret){const code=document.createElement('code');code.textContent=secret;result.append(document.createElement('br'),code);}
  }
  async function loadNotifyConfig(){
    try{const response=await fetch('/api/notify/config',{signal:AbortSignal.timeout(8000)});if(!response.ok)return;const config=await response.json();
      const email=root.querySelector<HTMLFormElement>('.email-form'),telegram=root.querySelector<HTMLButtonElement>('.telegram-connect'),unavailable=root.querySelector<HTMLElement>('.telegram-unavailable');
      if(email&&!config.channels?.email){email.querySelectorAll<HTMLInputElement|HTMLButtonElement>('input,button').forEach(item=>item.disabled=true);}
      if(telegram){telegram.hidden=!config.channels?.telegram?.enabled;telegram.disabled=!config.channels?.telegram?.enabled;}if(unavailable)unavailable.hidden=Boolean(config.channels?.telegram?.enabled);
    }catch{/* Other alert channels remain usable. */}
  }
  function showTooltip(target:HTMLElement){
    const source=target.querySelector<HTMLElement>('.calendar-tooltip');if(!source)return;tooltipTarget=target;floatingTooltip?.remove();
    floatingTooltip=source.cloneNode(true) as HTMLElement;floatingTooltip.removeAttribute('id');floatingTooltip.className='calendar-tooltip-floating';document.body.append(floatingTooltip);
    const anchor=target.getBoundingClientRect(),tip=floatingTooltip.getBoundingClientRect(),margin=10;
    const left=Math.min(window.innerWidth-tip.width-margin,Math.max(margin,anchor.left+anchor.width/2-tip.width/2));
    const above=anchor.top-tip.height-12,top=above>margin?above:anchor.bottom+12;
    floatingTooltip.dataset.placement=above>margin?'top':'bottom';floatingTooltip.style.left=`${left}px`;floatingTooltip.style.top=`${top}px`;
  }
  function hideTooltip(){floatingTooltip?.remove();floatingTooltip=null;tooltipTarget=null;}
  function applyFilters() {
    const rows = Array.from(root.querySelectorAll<HTMLElement>('.message-row'));
    if(!rows.length)return;
    let matched = 0;
    rows.forEach(row => { const match = filter === 'all' || row.dataset.kind === filter; row.hidden = !match || (!expanded && matched >= 6); if(match) matched++; });
    root.querySelectorAll<HTMLElement>('[data-filter]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.filter===filter)));
    const more = root.querySelector<HTMLButtonElement>('.show-more')!;
    more.hidden = matched <= 6;
    more.textContent = expanded ? t.less : `${t.more} (${matched})`;
    root.querySelector<HTMLElement>('.empty-state')!.hidden = matched !== 0;
  }
  function applyPosts(){
    const posts=Array.from(root.querySelectorAll<HTMLElement>('[data-post-index]'));
    posts.forEach(post=>post.hidden=!postsExpanded&&Number(post.dataset.postIndex)>=3);
    const button=root.querySelector<HTMLButtonElement>('.post-show-more');if(!button)return;
    button.setAttribute('aria-expanded',String(postsExpanded));button.textContent=postsExpanded?t.lessPosts:`${t.morePosts} (${Math.max(0,posts.length-3)})`;
  }
  async function refresh() {
    if (busy) return;
    busy=true;
    const button = root.querySelector<HTMLButtonElement>('.refresh')!;
    button.disabled=true;button.textContent=t.refreshing;
    try {
      const response=await fetch('/api/status', {signal:AbortSignal.timeout(12000)});
      if(!response.ok) throw new Error('Unavailable');
      const payload=await response.json();
      if(payload.version!==1 || !Array.isArray(payload.events)) throw new Error('Invalid response');
      const identity=JSON.stringify({events:payload.events,posts:payload.posts,collectorState:payload.collectorState});
      if(lastPayload!==identity) {
        const initialLoad=!lastPayload,knownIds=new Set(Array.from(root.querySelectorAll<HTMLElement>('[data-event-id]')).map(row=>row.dataset.eventId||''));
        const openIds=Array.from(root.querySelectorAll<HTMLDetailsElement>('details[open]')).map(d=>d.id);
        const openChannel=notificationDialog()?.open?notificationDialog()?.dataset.channel:'';root.innerHTML=renderTracker(payload,lang);
        openIds.forEach(id=>{const d=document.getElementById(id) as HTMLDetailsElement | null;if(d)d.open=true;});
        const newEvent=payload.events.find((item:{id:string,state:string,summary?:Record<string,string>,text:string})=>!knownIds.has(item.id)&&['signal','announced','rollout','completed','compensation'].includes(item.state));
        if(!initialLoad&&newEvent&&localStorage.getItem(notificationKey)==='on'&&'Notification' in window&&Notification.permission==='granted')new Notification(t.notifyTitle,{body:newEvent.summary?.[lang]||newEvent.text,tag:`codex-reset-${newEvent.id}`});
        if(openChannel)openNotification(openChannel);lastPayload=identity;applyFilters();applyPosts();applyTimeMode();updateNotificationButton();void loadNotifyConfig();void loadCommunity(false);
      }
      const time=root.querySelector<HTMLTimeElement>('.freshness time')!;
      time.dateTime=payload.lastSuccessAt||payload.lastReviewAt||'';time.dataset.timestamp=time.dateTime;time.textContent=dateLabel(time.dateTime,lang);applyTimeMode();
      const warning=root.querySelector<HTMLElement>('.connection-warning')!;
      warning.textContent=payload.collectorState==='connected'?t.stale:t.collectorBlocked;warning.hidden=payload.collectorState==='connected'&&Date.now()-Date.parse(payload.lastSuccessAt)<900000;
    } catch {
      const warning=root.querySelector<HTMLElement>('.connection-warning')!;warning.hidden=false;warning.textContent=t.offline;
    } finally { const b=root.querySelector<HTMLButtonElement>('.refresh')!; b.disabled=false;b.textContent=`↻ ${t.refresh}`;busy=false; }
  }
  root.addEventListener('click', event=>{
    const target=(event.target as HTMLElement).closest<HTMLElement>('button,a');if(!target)return;
    if(target.matches('.refresh'))void refresh();
    if(target.dataset.timeMode)setTimeMode(target.dataset.timeMode);
    if(target.matches('.beg-button'))void begForReset();
    if(target.dataset.notifyChannel)openNotification(target.dataset.notifyChannel);
    if(target.matches('.notify-close'))notificationDialog()?.close();
    if(target.matches('.telegram-connect'))void (async()=>{if(notificationBusy)return;notificationBusy=true;target.setAttribute('aria-busy','true');try{const response=await fetch('/api/notify/telegram/connect',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({lang}),signal:AbortSignal.timeout(8000)});const data=await response.json();if(!response.ok)throw new Error(data.error);location.href=data.url;}catch{notificationResult(t.notifyError);}finally{notificationBusy=false;target.removeAttribute('aria-busy');}})();
    if(target.matches('.post-show-more')){postsExpanded=!postsExpanded;applyPosts();}
    if(target.matches('.notify-toggle'))void (async()=>{if(!('Notification' in window))return;const permission=await Notification.requestPermission();if(permission==='granted')localStorage.setItem(notificationKey,'on');else localStorage.removeItem(notificationKey);updateNotificationButton();})();
    if(target.dataset.filter){filter=target.dataset.filter;expanded=false;applyFilters();}
    if(target.matches('.show-more')){expanded=!expanded;applyFilters();}
    if(target.matches('.day')){filter='all';expanded=true;applyFilters();}
  });
  root.addEventListener('submit',event=>{const form=event.target as HTMLFormElement;if(!form.matches('.notify-form'))return;event.preventDefault();void (async()=>{
    if(notificationBusy)return;notificationBusy=true;const button=form.querySelector<HTMLButtonElement>('button[type=submit]');if(button)button.disabled=true;notificationResult('');
    try{const isEmail=form.matches('.email-form'),input=form.querySelector<HTMLInputElement>('input')!,value=input.value.trim();if(isEmail&&!input.validity.valid){notificationResult(t.emailInvalid);return;}
      const response=await fetch(isEmail?'/api/notify/email':'/api/notify/webhook',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(isEmail?{email:value,lang}:{url:value,lang}),signal:AbortSignal.timeout(12000)}),data=await response.json();
      if(!response.ok){notificationResult(data.error==='rate_limited'?t.notifyRateLimited:t.notifyError);return;}notificationResult(isEmail?t.emailPending:t.webhookSaved,data.secret||'');if(isEmail)form.reset();
    }catch{notificationResult(t.notifyError);}finally{notificationBusy=false;if(button)button.disabled=false;}
  })});
  root.addEventListener('mouseover',event=>{const day=(event.target as HTMLElement).closest<HTMLElement>('.reset-day');if(day&&!day.contains(event.relatedTarget as Node|null))showTooltip(day);});
  root.addEventListener('mouseout',event=>{const day=(event.target as HTMLElement).closest<HTMLElement>('.reset-day');if(day&&!day.contains(event.relatedTarget as Node|null))hideTooltip();});
  root.addEventListener('focusin',event=>{const day=(event.target as HTMLElement).closest<HTMLElement>('.reset-day');if(day)showTooltip(day);});
  root.addEventListener('focusout',event=>{if((event.target as HTMLElement).closest('.reset-day'))hideTooltip();});
  const repositionTooltip=()=>{const target=tooltipTarget;if(target)requestAnimationFrame(()=>{if(target===tooltipTarget)showTooltip(target);});};
  window.addEventListener('scroll',repositionTooltip,{passive:true});window.addEventListener('resize',repositionTooltip,{passive:true});
  applyFilters();applyPosts();applyTimeMode();updateNotificationButton();void loadNotifyConfig();void loadCommunity();void refresh();
  const notifyState=new URLSearchParams(location.search).get('notify');if(notifyState){openNotification('email');notificationResult(notifyState==='email-confirmed'?t.emailConfirmed:t.notifyUnsubscribed);history.replaceState({},'',location.pathname);}
  setInterval(()=>void refresh(),60000);
  document.addEventListener('visibilitychange',()=>{if(!document.hidden)void refresh();});
</script>
